# Example environment for the agri-admin console.
# Copy to .env.local for local development (.env.local is gitignored).

# Base URL of the agri-api backend.
NEXT_PUBLIC_API_URL=https://back.agrogo-datafarm.com

# Mapbox token used by the map views.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# --- Single sign-on (identity gateway) ---

# Where to send the browser after logout / on an expired (401) session.
# Prod: the shared identity gateway login so logout truly leaves the SSO realm.
# Dev: defaults to /login when unset.
NEXT_PUBLIC_LOGIN_PATH=https://identity.agrogo-datafarm.com/login

# Domain the identity gateway scoped the shared SSO cookie to, so logout can
# expire it. Prod: the shared parent domain. Dev: leave empty (host-only cookie).
NEXT_PUBLIC_SSO_COOKIE_DOMAIN=.agrogo-datafarm.com

# Name of the shared SSO cookie (must match the identity gateway). Defaults to
# agrogo_sso when unset.
NEXT_PUBLIC_SSO_COOKIE_NAME=agrogo_sso
